{
  "version": "vida-adaptation-v1",
  "adaptation": {"unfreeze_blocks": 2, "rank": 8, "alpha": 16, "dropout": 0.05, "bias": "none", "targets": "query_value_only"},
  "training": {
    "partial_lr": 0.00001, "lora_lr": 0.0001, "head_lr": 0.0001,
