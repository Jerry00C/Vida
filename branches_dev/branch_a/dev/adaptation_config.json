{
  "version": "vida-adaptation-v1",
  "adaptation": {
    "unfreeze_blocks": 2
  },
  "training": {
    "partial_lr": 1e-05,
    "head_lr": 0.0001,
    "weight_decay": 0.0001,
    "batch_size": 8,
    "accumulation": 1,
    "frame_microbatch": 8,
    "epochs": 20,
    "seed": 42,
    "patience": 5,
    "min_delta": 0.0001,
    "scheduler_factor": 0.5,
    "scheduler_patience": 2,
    "balanced_classes": true,
    "equal_generators": true,
    "precision": "auto"
  }
}
