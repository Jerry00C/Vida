# Source and downloaded results are allowed; datasets stay local.
/*
!/.gitignore
!/README.md
!/.gitattributes
!/stacking/
/stacking/*
!/stacking/*.py
!/stacking/*.md
!/stacking/*.sh
!/stacking/requirements.txt
!/stacking/tests/
/stacking/tests/*
!/stacking/tests/test_*.py
!/preprocessing/
/preprocessing/*
!/preprocessing/*.py
!/preprocessing/*.md
!/preprocessing/requirements*.txt
!/branch_a/
/branch_a/*
!/branch_a/REMOTE_SETUP.md
!/branch_a/run_all_remote.sh
!/branch_a/dev/
/branch_a/dev/*
!/branch_a/dev/*.py
!/branch_a/dev/*.json
!/branch_a/dev/*.md
!/branch_a/dev/requirements*.txt
!/branch_a/tests/
/branch_a/tests/*
!/branch_a/tests/test_*.py

# Always exclude generated data, credentials, environments and caches.
**/__pycache__/
**/.pytest_cache/
**/.DS_Store
**/.env
**/.env.*
**/.venv*/
**/processed/
**/runs/
**/videos/
**/cache/
**/huggingface/
*.pt
*.safetensors
*.npy
*.zip
*.tar

# Downloaded experiment reports and LFS checkpoints.
!/remote-results/
/remote-results/**/.run.lock
!/remote-results/**/*.pt
