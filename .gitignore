# Code-only repository: new files are excluded unless explicitly allowed.
/*
!/.gitignore
!/README.md
!/preprocessing/
/preprocessing/*
!/preprocessing/*.py
!/preprocessing/*.md
!/preprocessing/requirements*.txt
!/dev/
/dev/*
!/dev/REMOTE_SETUP.md
!/dev/branch_a/
/dev/branch_a/*
!/dev/branch_a/*.py
!/dev/branch_a/*.json
!/dev/branch_a/*.md
!/dev/branch_a/requirements*.txt
!/dev/tests/
/dev/tests/*
!/dev/tests/test_*.py

# Always exclude generated data, credentials, environments and caches.
**/__pycache__/
**/.pytest_cache/
**/.DS_Store
**/.env
**/.env.*
**/.venv*/
**/processed/
**/runs/
**/videos/
**/cache/
**/huggingface/
*.pt
*.safetensors
*.npy
*.zip
*.tar
