# Source and downloaded results are allowed; datasets stay local.
/*
!/.gitignore
!/README.md
!/.gitattributes
!/stacking/
/stacking/*
!/stacking/*.py
!/stacking/*.md
!/stacking/*.sh
!/stacking/requirements.txt
!/stacking/tests/
/stacking/tests/*
!/stacking/tests/test_*.py
!/preprocessing/
/preprocessing/*
!/preprocessing/*.py
!/preprocessing/*.md
!/preprocessing/requirements*.txt
!/branch_a/
/branch_a/*
!/branch_a/REMOTE_SETUP.md
!/branch_a/run_all_remote.sh
!/branch_a/dev/
/branch_a/dev/*
!/branch_a/dev/*.py
!/branch_a/dev/*.json
!/branch_a/dev/*.md
!/branch_a/dev/requirements*.txt
!/branch_a/tests/
/branch_a/tests/*
!/branch_a/tests/test_*.py

# Branch C: source, documentation, tests and named aggregate results only.
!/dev/branch_c/
/dev/branch_c/*
!/dev/branch_c/.gitignore
!/dev/branch_c/README.md
!/dev/branch_c/pyproject.toml
!/dev/branch_c/requirements*.txt
!/dev/branch_c/configs/
/dev/branch_c/configs/*
!/dev/branch_c/configs/*.json
!/dev/branch_c/docs/
/dev/branch_c/docs/*
!/dev/branch_c/docs/*.md
!/dev/branch_c/examples/
/dev/branch_c/examples/*
!/dev/branch_c/examples/manifest.csv
!/dev/branch_c/scripts/
/dev/branch_c/scripts/*
!/dev/branch_c/scripts/*.py
!/dev/branch_c/src/
/dev/branch_c/src/*
!/dev/branch_c/src/branch_c/
/dev/branch_c/src/branch_c/*
!/dev/branch_c/src/branch_c/*.py
!/dev/branch_c/tests/
/dev/branch_c/tests/*
!/dev/branch_c/tests/test_*.py
!/dev/branch_c/validation/
/dev/branch_c/validation/*
!/dev/branch_c/validation/formal_verification.json
!/dev/branch_c/validation/verification.json
!/dev/branch_c/results/
/dev/branch_c/results/*
!/dev/branch_c/results/README.md
!/dev/branch_c/results/summary.json
!/dev/branch_c/results/protocol_summary.json
!/dev/branch_c/results/verification_summary.json
!/dev/branch_c/results/metrics_by_round.csv
!/dev/branch_c/results/generator_summary.csv
!/dev/branch_c/results/holdout_pairs.png
!/dev/branch_c/results/generator_holdouts.png

# Always exclude generated data, credentials, environments and caches.
**/__pycache__/
**/.pytest_cache/
**/.DS_Store
**/.env
**/.env.*
**/.venv*/
**/processed/
**/runs/
**/videos/
**/cache/
**/huggingface/
*.pt
*.safetensors
*.npy
*.zip
*.tar
**/data/
**/artifacts/
**/output/
**/*.egg-info/
*.joblib
*.pkl
*.pickle
*.npz
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.tar.gz
*.7z
*.rar

# Downloaded experiment reports and LFS checkpoints.
!/remote-results/
/remote-results/**/.run.lock
!/remote-results/**/*.pt

# Final fusion implementation, frozen small model and numeric/aggregate results.
!/stacking/requirements*.txt
!/stacking/config.example.json
!/stacking/config.expanded.example.json
!/stacking/released_model/
!/stacking/released_model/**
!/stacking/results/
!/stacking/results/**
/stacking/config.local.json
/stacking/config.*.local.json
!/stacking/RELEASE_CHECKSUMS.json
